+    logic [1:0] tail_q;
+    logic [1:0] count_q;
+    logic [3:0] capture_count_q;
+    logic [3:0] deliver_count_q;
+
+    function automatic logic [1:0] next_index(input logic [1:0] index);
+        next_index = (index == 2'd2) ? 2'd0 : index + 2'd1;
+    endfunction
+
+    function automatic logic [1:0] expected_tail(
+        input logic [1:0] head,
+        input logic [1:0] count
+    );
+        logic [1:0] once;
+        logic [1:0] twice;
+        begin
+            once = next_index(head);
+            twice = next_index(once);
+            unique case (count)
+                2'd0, 2'd3: expected_tail = head;
+                2'd1: expected_tail = once;
+                default: expected_tail = twice;
+            endcase
+        end
+    endfunction
+
+    always_comb begin
+        input_payload_c = '0;
+        input_payload_c.rdata = in_rdata_i;
+        input_payload_c.error = in_error_i;
+        input_payload_c.page_fault = in_page_fault_i;
+        input_payload_c.token = in_token_i;
+        output_payload_c = '0;
+        if (count_q != 2'd0) begin
+            unique case (head_q)
+                2'd0: output_payload_c = payload_q[0];
+                2'd1: output_payload_c = payload_q[1];
+                2'd2: output_payload_c = payload_q[2];
+                default: output_payload_c = '0;
+            endcase
+        end
+    end
+
+    // Responses always cross a clock edge. Capacity never includes a
+    // same-edge backend dequeue credit.
+    assign in_ready_o = !reset && (count_q < 2'd3);
+    assign capture_o = in_valid_i && in_ready_o;
+    assign out_valid_o = !reset && (count_q != 2'd0);
+    assign deliver_o = out_valid_o && out_ready_i;
+    assign out_rdata_o = output_payload_c.rdata;
+    assign out_error_o = output_payload_c.error;
+    assign out_page_fault_o = output_payload_c.page_fault;
+    assign out_token_o = output_payload_c.token;
+
+    assign occupied_o = (count_q != 2'd0);
+    assign occupancy_o = count_q;
+    assign conservation_error_o =
+        (count_q > 2'd3) ||
+        (head_q > 2'd2) ||
+        (tail_q > 2'd2) ||
+        (tail_q != expected_tail(head_q, count_q)) ||
+        ((capture_count_q - deliver_count_q) != {2'b0, count_q});
