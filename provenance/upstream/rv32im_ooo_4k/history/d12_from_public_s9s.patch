+                meta_fill_allowed_q[rsp_meta_slot_c] <= 1'b0;
+                meta_cache_owner_valid_q[rsp_meta_slot_c] <= 1'b0;
+                meta_word_addr_q[rsp_meta_slot_c] <= '0;
+                meta_waiter_valid_q[rsp_meta_slot_c] <= 1'b0;
+                meta_waiter_token_q[rsp_meta_slot_c] <= '0;
