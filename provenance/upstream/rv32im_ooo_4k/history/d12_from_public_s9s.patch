+        perf_store_origin_o[2] = |req_store_owner_c;
+        perf_store_origin_o[3] = store_poison_c;
+        perf_store_origin_o[4] = store_rsp_candidate_c;
+        perf_store_origin_o[5] = store_rsp_validates_c;
+        perf_store_origin_o[6] = store_rsp_candidate_c && mem_rsp_error_i;
