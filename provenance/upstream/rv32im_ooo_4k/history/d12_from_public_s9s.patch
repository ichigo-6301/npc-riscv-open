--- /dev/null
+++ b/rtl/profiles/rv32im_ooo_4k/core/ooo_persistent_recovery_owner.sv
@@ -0,0 +1,116 @@
+`timescale 1ns / 1ps
+`include "bbus_ooo_types.svh"
+
+module ooo_persistent_recovery_owner (
+    input  logic clk,
+    input  logic reset,
+    input  logic older_global_flush_i,
+
+    input  logic in_valid_i,
+    output logic in_ready_o,
+    input  bbus_ooo_redirect_t in_redirect_i,
+    input  logic [`BBUS_OOO_ROB_ENTRIES-1:0] in_kill_mask_i,
+    input  bbus_ooo_real_checkpoint_t in_checkpoint_i,
+    input  bbus_ooo_rob_tag_t in_post_tail_tag_i,
+    input  logic in_backend_acked_i,
+    input  logic backend_ack_i,
+
+    output logic frontend_valid_o,
+    input  logic frontend_ready_i,
+    output bbus_ooo_redirect_t frontend_redirect_o,
+
+    output logic capture_o,
+    output logic backend_ack_o,
+    output logic frontend_ack_o,
+    output logic complete_o,
+    output logic cancel_o,
+    output logic occupied_o,
+    output bbus_ooo_recovery_token_t token_o,
+    output logic conservation_error_o
+);
+    bbus_ooo_recovery_token_t token_q;
+    logic [31:0] next_epoch_q;
+    logic [7:0] capture_count_q;
+    logic [7:0] complete_count_q;
+    logic [7:0] cancel_count_q;
+    logic orphan_backend_ack_q;
+    logic duplicate_backend_ack_q;
+    logic invalid_capture_q;
+    logic resident_backend_ack_c;
+    logic backend_ack_effective_c;
+    logic frontend_ack_effective_c;
+
+    // A full owner never consumes same-cycle frontend service as new ingress
+    // credit. This is the causal cut between recovery production and frontend.
+    assign in_ready_o = !reset && !older_global_flush_i && !token_q.valid;
+    assign capture_o = in_valid_i && in_ready_o;
+    assign resident_backend_ack_c = token_q.valid && backend_ack_i &&
+        !token_q.backend_acked;
+    assign backend_ack_o = (capture_o && in_backend_acked_i) ||
+        resident_backend_ack_c;
+    assign frontend_valid_o = !reset && !older_global_flush_i &&
+        token_q.valid && token_q.backend_acked && !token_q.frontend_acked;
+    assign frontend_ack_o = frontend_valid_o && frontend_ready_i;
+    assign backend_ack_effective_c = token_q.backend_acked ||
+        resident_backend_ack_c;
+    assign frontend_ack_effective_c = token_q.frontend_acked || frontend_ack_o;
+    assign complete_o = token_q.valid && backend_ack_effective_c &&
+        frontend_ack_effective_c;
+    assign cancel_o = older_global_flush_i && token_q.valid;
+    assign occupied_o = token_q.valid;
+    assign frontend_redirect_o = token_q.redirect;
+    assign token_o = token_q;
+
+    assign conservation_error_o = invalid_capture_q ||
+        orphan_backend_ack_q || duplicate_backend_ack_q ||
+        (token_q.valid && !token_q.redirect.valid) ||
+        ((capture_count_q - complete_count_q - cancel_count_q) !=
+         {7'd0, token_q.valid});
+
+    always_ff @(posedge clk) begin
+        if (reset) begin
+            token_q <= '0;
+            next_epoch_q <= 32'd0;
+            capture_count_q <= 8'd0;
+            complete_count_q <= 8'd0;
+            cancel_count_q <= 8'd0;
+            orphan_backend_ack_q <= 1'b0;
+            duplicate_backend_ack_q <= 1'b0;
+            invalid_capture_q <= 1'b0;
+        end else begin
+            if (backend_ack_i && !token_q.valid && !capture_o)
+                orphan_backend_ack_q <= 1'b1;
+            if (backend_ack_i && token_q.valid && token_q.backend_acked)
+                duplicate_backend_ack_q <= 1'b1;
+
+            if (older_global_flush_i) begin
+                if (token_q.valid)
+                    cancel_count_q <= cancel_count_q + 8'd1;
+                token_q <= '0;
+            end else if (capture_o) begin
+                token_q <= '0;
+                token_q.valid <= 1'b1;
+                token_q.epoch <= next_epoch_q;
+                token_q.redirect <= in_redirect_i;
+                token_q.kill_mask <= in_kill_mask_i;
+                token_q.checkpoint <= in_checkpoint_i;
+                token_q.post_tail_tag <= in_post_tail_tag_i;
+                token_q.backend_acked <= in_backend_acked_i || backend_ack_i;
+                token_q.frontend_acked <= 1'b0;
+                next_epoch_q <= next_epoch_q + 32'd1;
+                capture_count_q <= capture_count_q + 8'd1;
+                if (!in_redirect_i.valid)
+                    invalid_capture_q <= 1'b1;
+            end else if (token_q.valid) begin
+                if (resident_backend_ack_c)
+                    token_q.backend_acked <= 1'b1;
+                if (frontend_ack_o)
+                    token_q.frontend_acked <= 1'b1;
+                if (complete_o) begin
+                    token_q <= '0;
+                    complete_count_q <= complete_count_q + 8'd1;
+                end
+            end
+        end
+    end
+endmodule
