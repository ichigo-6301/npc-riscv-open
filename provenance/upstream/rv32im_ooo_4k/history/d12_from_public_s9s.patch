+          token_equal(debug_load_offer_token_i, hit_rsp_token_q)) ||
+         (waiter_rsp_valid_q &&
+          token_equal(debug_load_offer_token_i, waiter_rsp_token_q)));
+    assign debug_load_ready_c = debug_load_offer_valid_i && !reset &&
