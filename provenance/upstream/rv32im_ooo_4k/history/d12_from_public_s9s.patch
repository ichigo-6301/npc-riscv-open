+    logic [31:0] waiter_rsp_data_q;
+    bbus_ooo_mem_token_t waiter_rsp_token_q;
+    logic conservation_error_q;
+
+    logic [WAY_COUNT-1:0][31:0] data_read_data_c;
+    logic [WAY_COUNT-1:0] data_collision_c;
+    logic [WAY_COUNT-1:0] data_write_enable_c;
