+    localparam int unsigned SET_COUNT = WORDS_PER_WAY / SECTORS_PER_LINE,
+    localparam int unsigned SET_W = $clog2(SET_COUNT),
+    localparam int unsigned TAG_W = 32 - 2 - DATA_ADDR_W
+) (
