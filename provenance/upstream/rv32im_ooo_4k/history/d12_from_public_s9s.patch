+    request_payload_t input_payload_c;
+    request_payload_t output_payload_c;
+    logic [1:0] head_q;
+    logic [1:0] tail_q;
+    logic [1:0] count_q;
+    logic [3:0] accept_count_q;
+    logic [3:0] service_count_q;
+    logic enqueue_storage_c;
+    logic dequeue_storage_c;
+    logic direct_service_c;
+
+    function automatic logic [1:0] next_index(input logic [1:0] index);
+        next_index = (index == 2'd2) ? 2'd0 : index + 2'd1;
+    endfunction
+
+    function automatic logic [1:0] expected_tail(
+        input logic [1:0] head,
+        input logic [1:0] count
+    );
+        logic [1:0] once;
+        logic [1:0] twice;
+        begin
+            once = next_index(head);
+            twice = next_index(once);
+            unique case (count)
+                2'd0, 2'd3: expected_tail = head;
+                2'd1: expected_tail = once;
+                default: expected_tail = twice;
+            endcase
+        end
+    endfunction
+
+    always_comb begin
+        input_payload_c = '0;
+        input_payload_c.write = in_write_i;
+        input_payload_c.access = in_access_i;
+        input_payload_c.addr = in_addr_i;
+        input_payload_c.wdata = in_wdata_i;
+        input_payload_c.wstrb = in_wstrb_i;
+        input_payload_c.len = in_len_i;
+        input_payload_c.token = in_token_i;
+        input_payload_c.satp = in_satp_i;
+        input_payload_c.mstatus = in_mstatus_i;
+        input_payload_c.priv_mode = in_priv_i;
+
+        output_payload_c = input_payload_c;
+        if (count_q != 2'd0) begin
+            unique case (head_q)
+                2'd0: output_payload_c = payload_q[0];
+                2'd1: output_payload_c = payload_q[1];
+                2'd2: output_payload_c = payload_q[2];
+                default: output_payload_c = '0;
+            endcase
+        end
+    end
+
+    // Admission credit deliberately excludes downstream ready and same-edge
+    // drain. An accepted request is an irrevocable ownership transfer.
+    assign in_ready_o = !reset && (count_q < 2'd3);
+    assign accept_o = in_valid_i && in_ready_o;
+    assign out_valid_o = !reset &&
+        ((count_q != 2'd0) || (in_valid_i && in_ready_o));
+    assign service_o = out_valid_o && out_ready_i;
+    assign direct_service_c = (count_q == 2'd0) && accept_o && service_o;
+    assign enqueue_storage_c = accept_o && !direct_service_c;
+    assign dequeue_storage_c = (count_q != 2'd0) && service_o;
+
+    assign out_write_o = output_payload_c.write;
+    assign out_access_o = output_payload_c.access;
+    assign out_addr_o = output_payload_c.addr;
+    assign out_wdata_o = output_payload_c.wdata;
+    assign out_wstrb_o = output_payload_c.wstrb;
+    assign out_len_o = output_payload_c.len;
+    assign out_token_o = output_payload_c.token;
+    assign out_satp_o = output_payload_c.satp;
+    assign out_mstatus_o = output_payload_c.mstatus;
+    assign out_priv_o = output_payload_c.priv_mode;
+
+    assign occupied_o = (count_q != 2'd0);
+    assign occupancy_o = count_q;
+    assign conservation_error_o =
+        (count_q > 2'd3) ||
+        (head_q > 2'd2) ||
+        (tail_q > 2'd2) ||
+        (tail_q != expected_tail(head_q, count_q)) ||
+        ((accept_count_q - service_count_q) != {2'b0, count_q});
+
+    always_ff @(posedge clk) begin
+        if (reset) begin
+            head_q <= 2'd0;
+            tail_q <= 2'd0;
+            count_q <= 2'd0;
+            accept_count_q <= 4'd0;
+            service_count_q <= 4'd0;
+            for (int unsigned i = 0; i < 3; i++) begin
+                payload_q[i] <= '0;
+            end
+        end else begin
+            if (enqueue_storage_c) begin
+                payload_q[tail_q] <= input_payload_c;
+                tail_q <= next_index(tail_q);
+            end
+            if (dequeue_storage_c) begin
+                head_q <= next_index(head_q);
+            end
+            unique case ({enqueue_storage_c, dequeue_storage_c})
+                2'b10: count_q <= count_q + 2'd1;
+                2'b01: count_q <= count_q - 2'd1;
+                default: count_q <= count_q;
+            endcase
+            if (accept_o) begin
+                accept_count_q <= accept_count_q + 4'd1;
+            end
+            if (service_o) begin
+                service_count_q <= service_count_q + 4'd1;
+            end
+        end
+    end
+endmodule
