--- /dev/null
+++ b/rtl/profiles/rv32im_ooo_4k/memory/ooo_dcache_data_array_1r1w_512x32.sv
@@ -0,0 +1,46 @@
+`timescale 1ns / 1ps
+
+// One-cycle synchronous read and byte-masked write contract shared by the
+// behavioral model and the OpenRAM ASIC leaf.
+module ooo_dcache_data_array_1r1w_512x32 (
+    input  logic clk,
+    input  logic read_enable_i,
+    input  logic [8:0] read_addr_i,
+    output logic [31:0] read_data_o,
+    input  logic write_enable_i,
+    input  logic [8:0] write_addr_i,
+    input  logic [31:0] write_data_i,
+    input  logic [3:0] write_mask_i,
+    output logic collision_o
+);
+    assign collision_o = read_enable_i && write_enable_i &&
+        (read_addr_i == write_addr_i);
+
+`ifdef NPC_ASIC_SRAM
+    npc_dcache_data_1r1w_512x32_b8 u_macro (
+        .clk0(clk),
+        .csb0(!write_enable_i),
+        .wmask0(write_mask_i),
+        .addr0(write_addr_i),
+        .din0(write_data_i),
+        .clk1(clk),
+        .csb1(!read_enable_i),
+        .addr1(read_addr_i),
+        .dout1(read_data_o)
+    );
+`else
+    logic [31:0] data_q [0:511];
+
+    always_ff @(posedge clk) begin
+        if (read_enable_i)
+            read_data_o <= data_q[read_addr_i];
+        if (write_enable_i) begin
+            for (int unsigned byte_idx = 0; byte_idx < 4; byte_idx++) begin
+                if (write_mask_i[byte_idx])
+                    data_q[write_addr_i][byte_idx * 8 +: 8] <=
+                        write_data_i[byte_idx * 8 +: 8];
+            end
+        end
+    end
+`endif
+endmodule
