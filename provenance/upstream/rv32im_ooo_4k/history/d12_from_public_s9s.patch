+        if (!left.valid)
+            older_candidate = right;
+        else if (!right.valid)
+            older_candidate = left;
+        else if (left.rank < right.rank)
+            older_candidate = left;
+        else if (right.rank < left.rank)
+            older_candidate = right;
+        else if (left.tag < right.tag)
+            older_candidate = left;
+        else if (right.tag < left.tag)
+            older_candidate = right;
+        else if (left.slot <= right.slot)
+            older_candidate = left;
+        else
