+
+    logic [1:0] effective_meta_valid_c;
+    logic meta_slot_available_c, meta_alloc_slot_c;
+    logic [1:0] req_same_word_meta_c, req_coalesce_match_c;
+    logic req_coalesce_known_c, req_coalesce_slot_c;
+    logic req_coalesce_candidate_c, req_coalesce_fire_c;
+    logic forwarded_req_fire_c, cacheable_load_fire_c, miss_fire_c;
+    logic store_req_fire_c, store_invalidate_c, store_cache_update_c;
+    logic store_cache_way_c, store_poison_c, amo_invalidate_c;
+
+    logic [1:0] rsp_meta_match_c;
+    logic rsp_meta_known_c, rsp_meta_slot_c, down_rsp_fire_c;
+    logic rsp_owner_match_c, rsp_owner_way_c;
+    logic [SET_W-1:0] rsp_owner_set_c;
+    logic [SECTOR_W-1:0] rsp_owner_sector_c;
+    logic [DATA_ADDR_W-1:0] rsp_owner_word_index_c;
+    logic load_fill_candidate_c, load_fill_accept_c;
+    logic fill_store_conflict_c, fill_replacement_conflict_c;
+    logic store_rsp_candidate_c, store_rsp_validates_c;
+    logic primary_rsp_has_waiter_c, coalesce_on_primary_rsp_c;
+    logic waiter_rsp_enqueue_c;
+    bbus_ooo_mem_token_t waiter_rsp_enqueue_token_c;
