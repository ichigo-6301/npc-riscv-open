+    logic [TAG_W-1:0] req_tag_c;
+    logic [WAY_COUNT-1:0] req_tag_match_c, req_sector_valid_c;
+    logic [WAY_COUNT-1:0] req_load_hit_c;
+    logic [WAY_COUNT-1:0] req_store_owner_c, req_way_has_owner_c;
+    logic req_hit_way_c, req_array_hit_c;
+    logic req_alloc_way_c, req_alloc_retag_c, req_alloc_possible_c;
+    logic req_selected_state_owner_c, req_selected_owner_slot_c;
+    logic hit_rsp_fire_c, waiter_rsp_fire_c;
