+                    meta_fill_allowed_q[prior_state[0]] <= 1'b0;
+                end
+                sector_state_q[store_cache_way_c][req_set_c][req_sector_c] <=
+                    owner_state(meta_alloc_slot_c);
+                replacement_way_q[req_set_c] <= !store_cache_way_c;
+            end
