+    logic req_len_legal_c, req_shape_legal_c, req_protocol_legal_c;
+    logic req_cacheable_range_c, req_cacheable_load_c;
+    logic [32:0] req_last_byte_c, pmem_limit_c;
+    logic [31:0] req_word_addr_c;
